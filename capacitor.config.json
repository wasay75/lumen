{
  "appId": "com.lumen.puzzle",
  "appName": "Lumen",
  "webDir": "www",
  "backgroundColor": "#0a0b0e",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0a0b0e"
  },
  "android": {
    "backgroundColor": "#0a0b0e"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 900,
      "backgroundColor": "#0a0b0e",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0b0e"
    }
  }
}
